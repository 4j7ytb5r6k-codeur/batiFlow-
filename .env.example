# Copie ce fichier en ".env" (même dossier) et colle ta clé après le signe =
# Exemple : ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_API_KEY=

# Optionnel : modèle de Claude à utiliser (par défaut : claude-opus-5-5)
# Pour un coût plus faible, tu peux essayer : claude-sonnet-5-5
# CLAUDE_MODEL=claude-opus-5-5
